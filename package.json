{
  "name": "deliverify",
  "private": true,
  "version": "1.0.0",
  "description": "Deliverify Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "start:backend": "npm run start -w backend",
    "test:backend": "npm test -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
